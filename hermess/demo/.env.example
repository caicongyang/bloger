# Copy to .env and fill in your key.
# Supports any OpenAI-compatible endpoint (DeepSeek / 通义千问 / 智谱 / ...).

# --- DeepSeek (default) ---
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# --- Alibaba DashScope (通义千问), uncomment to use ---
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DEEPSEEK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DEEPSEEK_MODEL=qwen-plus

# --- Zhipu (智谱 GLM), uncomment to use ---
# DEEPSEEK_API_KEY=xxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxx
# DEEPSEEK_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# DEEPSEEK_MODEL=glm-4-plus
